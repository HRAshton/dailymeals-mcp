PORT=8080
DAILYMEALS_ORIGIN=https://dailymeals.rs
# Supply one of these. For Cloud Run, mount a Secret Manager version at the file path.
DAILYMEALS_COOKIE=
DAILYMEALS_COOKIE_FILE=/var/secrets/dailymeals/cookie
# Required: callers send Authorization: Bearer <value>.
MCP_AUTH_TOKEN=
# Cloud Run: use Firestore for cross-instance idempotency.
FIRESTORE_IDEMPOTENCY_COLLECTION=dailymeals-mcp-idempotency
# Local development only. Production intentionally fails closed without Firestore.
IDEMPOTENCY_BACKEND=firestore
